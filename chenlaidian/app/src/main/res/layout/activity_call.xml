<?xml version="1.0" encoding="utf-8"?>
<!-- 0.33 按她参考图重排：磨砂灰渐变背景 / 圆头像居中 / 字幕区可回翻(0.32) / 红绿圆钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp"
    android:background="@drawable/call_bg">

    <TextView android:id="@+id/btnMinimize" android:layout_width="44dp" android:layout_height="36dp"
        android:text="⌄" android:textSize="24sp" android:textColor="#B9B4AE" android:gravity="center" />

    <TextView android:id="@+id/avatar"
        android:layout_width="72dp" android:layout_height="72dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
        android:background="@drawable/avatar_circle"
        android:gravity="center" android:text="辰"
        android:textSize="30sp" android:textStyle="bold" android:textColor="#26262B" />

    <TextView android:id="@+id/callText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="辰打电话来了" android:textSize="16sp" android:textColor="#E6FFFFFF" android:layout_marginTop="10dp" />

    <TextView android:id="@+id/callState" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="响铃中…" android:textSize="13sp" android:textColor="#B3FFFFFF" android:layout_marginTop="3dp" />

    <!-- 0926 她点的（参考微信通话页）：标题/状态改白 90%/70%。0927 她又说字幕的白框不要了 只要字浮在模糊背景上：去掉 caption_card 背景 字加一点点阴影防糊 -->
    <ScrollView android:id="@+id/capScroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="14dp" android:fillViewport="true" android:scrollbars="vertical"
        android:padding="12dp">
        <!-- 0.41 她点单：说的话页面居中 不靠左 -->
        <TextView android:id="@+id/callLast" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="15sp" android:textColor="#CCFFFFFF"
            android:lineSpacingExtra="6dp" android:gravity="center_horizontal" android:paddingBottom="12dp"
            android:shadowColor="#66000000" android:shadowRadius="4" android:shadowDy="1" />
    </ScrollView>

    <!-- 0926 她点的（参考微信通话页）：底部一排 64dp 圆钮等距居中，下面 12sp 白色小字标签。
         通话中 = [挂断 红底白听筒][免提 白底深喇叭]；响铃中 = [挂断][接听]。app 没有用户静音功能，所以没做麦克风键。
         原来紫色的「免提：关」胶囊是裸 <Button> 被 Material3 主题偷换成 MaterialButton 用主题色 tint 染的（0.39 挂断/接听同款问题），这里全用 AppCompat 控件 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center">
            <!-- 0.39 紫按钮修复:Material3主题把<Button>偷换成MaterialButton 用主题色tint盖掉background;AppCompat 控件不吃这套 -->
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnHangup" android:layout_width="64dp" android:layout_height="64dp"
                android:background="@drawable/btn_circle_red"
                android:src="@drawable/ic_call_end" android:scaleType="center"
                android:contentDescription="挂断" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="挂断" android:textSize="12sp" android:textColor="#B3FFFFFF" android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/speakerWrap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:visibility="gone">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnSpeaker" android:layout_width="64dp" android:layout_height="64dp"
                android:background="@drawable/btn_circle_white"
                android:src="@drawable/ic_volume_up" android:scaleType="center"
                android:contentDescription="免提" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="免提" android:textSize="12sp" android:textColor="#B3FFFFFF" android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/acceptWrap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAccept" android:layout_width="64dp" android:layout_height="64dp"
                android:background="@drawable/btn_circle_green"
                android:text="✓" android:textSize="24sp" android:textColor="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="接听" android:textSize="12sp" android:textColor="#B3FFFFFF" android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
